# Site meta (title, favicon, lang, description) come from the mock API /api/config.json at runtime.
# No env vars are used for index.html; replace MOCK_API_CONFIG_URL in configService.js with your API URL when ready.
# Optional: inject into index.html at build time (fallbacks used if unset)
# Runtime config (or API) can still override these after load.
VITE_WEBSITE_NAME=Casino
VITE_FAVICON=/favicon.svg
VITE_DEFAULT_LANG=en
VITE_META_DESCRIPTION=Casino – Sports, Casino, Tables.


